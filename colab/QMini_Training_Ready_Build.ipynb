    "# ---------------- INSTALL OPEN-SOURCE DEPENDENCIES ----------------",
    "# Keep Colab's preinstalled CUDA-enabled PyTorch wheel. Do not replace it.",
    "run_checked([",
    "    sys.executable, \"-m\", \"pip\", \"install\",",
    "    \"numpy>=1.24\", \"tokenizers>=0.15\", \"pyarrow>=15.0\", \"packaging>=23\",",
    "])",
    "run_checked([sys.executable, \"-m\", \"pip\", \"install\", \"--no-deps\", \"-e\", \".\"], cwd=REPO_DIR)",
    "",
    "import torch",
    "from packaging.version import Version",
    "",
    "torch_version = Version(torch.__version__.split(\"+\", 1)[0])",
    "if torch_version < Version(\"2.10.0\"):",
    "    raise RuntimeError(",
    "        f\"Q-Mini requires PyTorch >=2.10.0; Colab has {torch.__version__}. \"",
    "        \"Select a compatible runtime instead of blindly replacing the CUDA wheel.\"",
    "    )",
    "",
    "print(\"Python:\", sys.version.split()[0])",
    "print(\"PyTorch:\", torch.__version__)",
    "print(\"CUDA build:\", torch.version.cuda)",
    "print(\"CUDA available:\", torch.cuda.is_available())",
    "if torch.cuda.is_available():",
    "    print(\"GPU:\", torch.cuda.get_device_name(0))",
    "else:",
    "    print(\"Build-only mode is CPU-compatible; later neural-model training requires a suitable GPU.\")"
   ]
