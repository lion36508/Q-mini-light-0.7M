    "# ---------------- DATASET FINGERPRINT + PACKAGE ID ----------------from qmini.config import QMiniConfigbase_config = QMiniConfig.from_json(MODEL_CONFIG_PATH)if not 600_000 <= base_config.estimated_parameter_count() <= 800_000:    raise RuntimeError(        \"This notebook is deliberately limited to the <=250M Colab research profile. \"        \"The 5B profile requires a real distributed trainer that this repository does not yet implement.\"    )if RELEASE_MODE and not SOURCE_METADATA_REL:    raise ValueError(\"RELEASE_MODE=True requires SOURCE_METADATA_REL to point to a source/license manifest.\")SOURCE_METADATA_PATH = (MY_DRIVE / SOURCE_METADATA_REL) if SOURCE_METADATA_REL else Noneif SOURCE_METADATA_PATH is not None and not SOURCE_METADATA_PATH.is_file():    raise FileNotFoundError(f\"Dataset source metadata not found: {SOURCE_METADATA_PATH}\")data_files = sorted(    path for path in DATA_DIR.rglob(\"*\")    if path.is_file() and not any(part.startswith(\".\") for part in path.relative_to(DATA_DIR).parts))if not data_files:    raise FileNotFoundError(        f\"No corpus files found in {DATA_DIR}. Put your reviewed text/JSONL/Parquet corpus there, then rerun.\"    )def sha256_file(path):    digest = hashlib.sha256()    with Path(path).open(\"rb\") as handle:        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b\"\"):            digest.update(chunk)    return digest.hexdigest()source_records = []for path in data_files:    source_records.append({        \"relative_path\": path.relative_to(DATA_DIR).as_posix(),        \"size_bytes\": path.stat().st_size,        \"sha256\": sha256_file(path),    })source_metadata_sha256 = (    sha256_file(SOURCE_METADATA_PATH) if SOURCE_METADATA_PATH is not None else None)package_identity = {    \"format\": \"qmini-training-ready-package-id-v1\",    \"source_revision\": SOURCE_REVISION,    \"model_config\": base_config.to_dict(),    \"dataset_files\": source_records,    \"source_metadata_sha256\": source_metadata_sha256,    \"tokenizer\": {        \"type\": \"byte-level-bpe\",        \"vocab_size_target\": VOCAB_SIZE,        \"validation_fraction\": VALIDATION_FRACTION,        \"near_duplicate_hamming_distance\": NEAR_DUPLICATE_HAMMING_DISTANCE,    },    \"preparation\": {        \"loss_mask_mode\": LOSS_MASK_MODE,        \"minimum_sequence_length\": TRAIN_SEQUENCE_LENGTH,    },    \"release_mode\": RELEASE_MODE,}PACKAGE_KEY = hashlib.sha256(    json.dumps(package_identity, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")).hexdigest()[:16]PACKAGE_NAME = f\"QMini-Light-0.7M-Q2v2-{PACKAGE_KEY}\"LOCAL_PACKAGE_DIR = Path(\"/content\") / PACKAGE_NAMEFINAL_PACKAGE_DIR = ART_ROOT / \"training_ready\" / PACKAGE_NAMEFINAL_PACKAGE_DIR.parent.mkdir(parents=True, exist_ok=True)print(\"Corpus files:\", len(source_records))print(\"Corpus bytes:\", f\"{sum(item['size_bytes'] for item in source_records):,}\")print(\"Package identity:\", PACKAGE_KEY)print(\"Final Drive package:\", FINAL_PACKAGE_DIR)"
   ]
