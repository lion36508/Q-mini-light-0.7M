    "# ---------------- TOKENIZER + TOKEN STREAMS + FULL MODEL BUILD ----------------from qmini.tokenizer import load_tokenizerfrom qmini.text import SPECIAL_TOKENSfrom qmini.export import verify_packed_exportfrom qmini.train import (    _verify_initial_brain_artifact,    _verify_prepared_dataset_manifest,    _load_tokens,    _validate_token_ids,)def verify_package(package_dir):    package_dir = Path(package_dir)    tokenizer_path = package_dir / \"tokenizer\" / \"tokenizer.json\"    tokenizer_sidecar = Path(str(tokenizer_path) + \".qmini.json\")    dataset_dir = package_dir / \"dataset\"    initial_dir = package_dir / \"initial_brain\"    config_path = initial_dir / \"config.json\"    model_path = initial_dir / \"model.qmini.npz\"    manifest_path = initial_dir / \"model_manifest.json\"    runtime_dir = package_dir / \"training_runtime\"    runtime_manifest_path = runtime_dir / \"TRAINING_RUNTIME.json\"    progress_path = package_dir / \"training_state\" / \"training_progress.json\"    active_config_path = package_dir / \"active_config.json\"    required = [        tokenizer_path, tokenizer_sidecar, active_config_path, dataset_dir / \"train.bin\",        dataset_dir / \"valid.bin\", dataset_dir / \"train.mask.bin\",        dataset_dir / \"valid.mask.bin\", dataset_dir / \"dataset.json\",        config_path, model_path, manifest_path,        runtime_manifest_path, runtime_dir / \"qmini\" / \"train.py\",        runtime_dir / \"qmini\" / \"checkpointing.py\", progress_path,    ]    missing = [str(path) for path in required if not path.is_file()]    if missing:        raise FileNotFoundError(\"Training-ready package is incomplete: \" + \", \".join(missing))    config = QMiniConfig.from_json(config_path)    if QMiniConfig.from_json(active_config_path).to_dict() != config.to_dict():        raise RuntimeError(\"Root active_config.json differs from initial_brain/config.json.\")    tokenizer = load_tokenizer(tokenizer_path)    if tokenizer.get_vocab_size() != config.vocab_size:        raise RuntimeError(\"Tokenizer vocabulary size does not match the model config.\")    for token in SPECIAL_TOKENS:        if tokenizer.token_to_id(token) is None:            raise RuntimeError(f\"Tokenizer is missing required structural token: {token}\")    packed_report = verify_packed_export(model_path)    if (        packed_report.get(\"format\") != \"qmini-packed-v2\"        or packed_report.get(\"q2_version\") != 2        or packed_report.get(\"parameter_count\") != config.estimated_parameter_count()    ):        raise RuntimeError(\"Q2-v2 archive failed format/version/parameter verification.\")    _verify_initial_brain_artifact(model_path, config)    _verify_prepared_dataset_manifest(        dataset_dir / \"train.bin\", dataset_dir / \"valid.bin\",        tokenizer_path, dataset_dir / \"train.mask.bin\",        dataset_dir / \"valid.mask.bin\", config.vocab_size,    )    train_tokens = _load_tokens(dataset_dir / \"train.bin\", \"Training\")    valid_tokens = _load_tokens(dataset_dir / \"valid.bin\", \"Validation\")    _validate_token_ids(train_tokens, config.vocab_size, \"Training\")    _validate_token_ids(valid_tokens, config.vocab_size, \"Validation\")    if len(train_tokens) < TRAIN_SEQUENCE_LENGTH + 2:        raise ValueError(\"Training corpus is too short for TRAIN_SEQUENCE_LENGTH.\")    if len(valid_tokens) < TRAIN_SEQUENCE_LENGTH + 2:        raise ValueError(\"Validation corpus is too short for TRAIN_SEQUENCE_LENGTH.\")    runtime_manifest = json.loads(runtime_manifest_path.read_text(encoding=\"utf-8\"))    if runtime_manifest.get(\"enabled\") is not False or runtime_manifest.get(\"requires_manual_activation\") is not True:        raise RuntimeError(\"Training runtime must be packaged but disabled by default.\")    for record in runtime_manifest.get(\"source_files\", []):        relative = Path(record[\"path\"])        if relative.is_absolute() or \"..\" in relative.parts:            raise RuntimeError(\"Training runtime manifest contains an unsafe source path.\")        source_file = runtime_dir / relative        if not source_file.is_file() or sha256_file(source_file) != record.get(\"sha256\"):            raise RuntimeError(f\"Training runtime source hash mismatch: {relative}\")    progress = json.loads(progress_path.read_text(encoding=\"utf-8\"))    if progress.get(\"status\") != \"not_started\" or progress.get(\"current_step\") != 0:        raise RuntimeError(\"A fresh package must start with training disabled at step zero.\")    model_manifest = json.loads(manifest_path.read_text(encoding=\"utf-8\"))    if model_manifest.get(\"training_runtime_manifest_sha256\") != sha256_file(runtime_manifest_path):        raise RuntimeError(\"Training runtime manifest does not match the root model-manifest fingerprint.\")    if model_manifest.get(\"training_steps\") != 0 or model_manifest.get(\"optimizer_steps\") != 0:        raise RuntimeError(\"Initial brain unexpectedly contains model-training updates.\")    if model_manifest.get(\"matrix_weight_bits\") != 2:        raise RuntimeError(\"Initial brain is not a Q2-v2 two-bit matrix-weight artifact.\")    return {        \"config\": config,        \"packed_report\": packed_report,        \"model_manifest\": model_manifest,        \"tokenizer_sha256\": sha256_file(tokenizer_path),        \"dataset_manifest\": json.loads((dataset_dir / \"dataset.json\").read_text(encoding=\"utf-8\")),        \"train_tokens\": len(train_tokens),        \"valid_tokens\": len(valid_tokens),    }if FINAL_PACKAGE_DIR.is_dir():    print(\"A package with this exact source/config fingerprint already exists. Verifying; no overwrite will occur.\")    PACKAGE_DIR = FINAL_PACKAGE_DIR    verified = verify_package(PACKAGE_DIR)else:    if LOCAL_PACKAGE_DIR.exists():        raise FileExistsError(            f\"Local staging folder already exists: {LOCAL_PACKAGE_DIR}. \"            \"Reconnect to a fresh Colab runtime rather than deleting an unverified build.\"        )    LOCAL_PACKAGE_DIR.mkdir(parents=True, exist_ok=False)    TOKENIZER_DIR = LOCAL_PACKAGE_DIR / \"tokenizer\"    DATASET_DIR = LOCAL_PACKAGE_DIR / \"dataset\"    INITIAL_DIR = LOCAL_PACKAGE_DIR / \"initial_brain\"    TOKENIZER_DIR.mkdir()    TOKENIZER_PATH = TOKENIZER_DIR / \"tokenizer.json\"    TOKENIZER_CONFIG_PATH = LOCAL_PACKAGE_DIR / \"active_config.json\"    tokenizer_command = [        sys.executable, \"-m\", \"qmini.cli\", \"tokenizer\",        \"--data-dir\", str(DATA_DIR),        \"--output\", str(TOKENIZER_PATH),        \"--vocab-size\", str(VOCAB_SIZE),        \"--base-config\", str(MODEL_CONFIG_PATH),        \"--valid-fraction\", str(VALIDATION_FRACTION),        \"--near-duplicate-hamming-distance\", str(NEAR_DUPLICATE_HAMMING_DISTANCE),        \"--config-output\", str(TOKENIZER_CONFIG_PATH),    ]    if SOURCE_METADATA_PATH is not None:        tokenizer_command.extend([\"--source-metadata\", str(SOURCE_METADATA_PATH)])    if RELEASE_MODE:        tokenizer_command.append(\"--release-mode\")    run_checked(tokenizer_command, cwd=REPO_DIR)    active_config = QMiniConfig.from_json(TOKENIZER_CONFIG_PATH)    active_values = active_config.to_dict()    base_values = base_config.to_dict()    base_values[\"vocab_size\"] = active_config.vocab_size    if active_values != base_values:        raise RuntimeError(\"Tokenizer creation unexpectedly changed architecture fields other than vocab_size.\")    tokenizer = load_tokenizer(TOKENIZER_PATH)    if tokenizer.get_vocab_size() != active_config.vocab_size:        raise RuntimeError(\"Tokenizer and active model config vocabulary do not match.\")    for token in SPECIAL_TOKENS:        if tokenizer.token_to_id(token) is None:            raise RuntimeError(f\"Tokenizer is missing required structural token: {token}\")    prepare_command = [        sys.executable, \"-m\", \"qmini.cli\", \"prepare\",        \"--data-dir\", str(DATA_DIR),        \"--tokenizer\", str(TOKENIZER_PATH),        \"--output-dir\", str(DATASET_DIR),        \"--valid-fraction\", str(VALIDATION_FRACTION),        \"--near-duplicate-hamming-distance\", str(NEAR_DUPLICATE_HAMMING_DISTANCE),        \"--loss-mask\", LOSS_MASK_MODE,    ]    if SOURCE_METADATA_PATH is not None:        prepare_command.extend([\"--source-metadata\", str(SOURCE_METADATA_PATH)])    if RELEASE_MODE:        prepare_command.append(\"--release-mode\")    run_checked(prepare_command, cwd=REPO_DIR)    run_checked([        sys.executable, \"-m\", \"qmini.cli\", \"audit\",        \"--config\", str(TOKENIZER_CONFIG_PATH),    ], cwd=REPO_DIR, capture_output=False)    parameter_count = active_config.estimated_parameter_count()    if parameter_count > 800_000:        raise RuntimeError(\"The selected profile exceeds this notebook's single-device Colab limit.\")    LOCAL_INITIAL_DIR = LOCAL_PACKAGE_DIR / \"initial_brain\"    run_checked([        sys.executable, \"-m\", \"qmini.cli\", \"build-initial\",        \"--config\", str(TOKENIZER_CONFIG_PATH),        \"--output-dir\", str(LOCAL_INITIAL_DIR),        \"--source-revision\", SOURCE_REVISION,    ], cwd=REPO_DIR)    # Bind the initial weights to the exact tokenizer and prepared corpus.    manifest_path = LOCAL_INITIAL_DIR / \"model_manifest.json\"    model_manifest = json.loads(manifest_path.read_text(encoding=\"utf-8\"))    dataset_manifest_path = DATASET_DIR / \"dataset.json\"    dataset_manifest = json.loads(dataset_manifest_path.read_text(encoding=\"utf-8\"))    model_manifest.update({        \"tokenizer_included\": True,        \"tokenizer_relative_path\": \"../tokenizer/tokenizer.json\",        \"tokenizer_sha256\": sha256_file(TOKENIZER_PATH),        \"tokenizer_manifest_sha256\": sha256_file(Path(str(TOKENIZER_PATH) + \".qmini.json\")),        \"prepared_dataset_relative_path\": \"../dataset\",        \"prepared_dataset_manifest_sha256\": sha256_file(dataset_manifest_path),        \"train_tokens_sha256\": dataset_manifest[\"train_tokens_sha256\"],        \"valid_tokens_sha256\": dataset_manifest[\"valid_tokens_sha256\"],        \"train_mask_sha256\": dataset_manifest.get(\"train_mask_sha256\"),        \"valid_mask_sha256\": dataset_manifest.get(\"valid_mask_sha256\"),        \"corpus_sha256\": dataset_manifest.get(\"corpus_sha256\"),        \"source_provenance_sha256\": dataset_manifest.get(\"source_provenance_sha256\"),        \"release_mode\": bool(dataset_manifest.get(\"release_mode\", False)),    })    manifest_path.write_text(        json.dumps(model_manifest, indent=2, sort_keys=True, allow_nan=False) + \"\\n",
    "\",        encoding=\"utf-8\",    )    # Add an inspectable build report without changing model weights.    build_report = {        \"format\": \"qmini-training-ready-build-report-v1\",        \"package_key\": PACKAGE_KEY,        \"source_revision\": SOURCE_REVISION,        \"config\": active_config.to_dict(),        \"parameters\": parameter_count,        \"architecture\": {            \"causal_depthwise_convolution\": True,            \"gated_diagonal_state_space\": bool(active_config.use_state_space),            \"sparse_top1_moe\": active_config.n_experts > 1 and active_config.top_k == 1,            \"shared_refinement_block\": True,            \"transformer_self_attention\": False,            \"qkv_attention\": False,        },        \"initial_model\": {            \"format\": \"qmini-packed-v2\",            \"matrix_weight_bits\": 2,            \"sha256\": sha256_file(LOCAL_INITIAL_DIR / \"model.qmini.npz\"),            \"bytes\": (LOCAL_INITIAL_DIR / \"model.qmini.npz\").stat().st_size,        },        \"tokenizer\": {            \"path\": \"tokenizer/tokenizer.json\",            \"vocabulary_size\": tokenizer.get_vocab_size(),            \"sha256\": sha256_file(TOKENIZER_PATH),        },        \"dataset\": {            \"path\": \"dataset/\",            \"manifest_sha256\": sha256_file(dataset_manifest_path),            \"train_tokens\": int(dataset_manifest[\"train_tokens\"]),            \"valid_tokens\": int(dataset_manifest[\"valid_tokens\"]),            \"loss_mask_mode\": dataset_manifest[\"loss_mask_mode\"],            \"release_mode\": bool(dataset_manifest.get(\"release_mode\", False)),        },        \"source_corpus_fingerprint\": PACKAGE_KEY,        \"training\": {            \"started\": False,            \"training_steps\": 0,            \"optimizer_steps\": 0,            \"tokens_seen\": 0,        },        \"precision\": {            \"matrix_weights\": \"Q2-v2 / 2-bit symbols\",            \"row_scales\": \"FP32\",            \"one_dimensional_parameters\": \"FP16 in packed export\",            \"later_QAT_master_parameters\": \"FP32\",            \"later_AdamW_state\": \"FP32\",            \"activations\": \"signed INT8 fake quantization\",        },    }    (LOCAL_PACKAGE_DIR / \"BUILD_REPORT.json\").write_text(        json.dumps(build_report, indent=2, ensure_ascii=False, sort_keys=True) + \"\\n",
    "\",        encoding=\"utf-8\",    )    # Bundle the complete Q-Mini training source, but keep it dormant.    runtime_dir = LOCAL_PACKAGE_DIR / \"training_runtime\"    runtime_dir.mkdir(parents=True, exist_ok=False)    source_package = runtime_dir / \"qmini\"    shutil.copytree(        REPO_DIR / \"qmini\",        source_package,        ignore=shutil.ignore_patterns(\"__pycache__\", \"*.pyc\", \"*.so\", \"*.pyd\"),    )    shutil.copy2(REPO_DIR / \"pyproject.toml\", runtime_dir / \"pyproject.toml\")    training_defaults = {        \"format\": \"qmini-training-defaults-v1\",        \"enabled\": False,        \"batch_size\": 1,        \"sequence_length\": 1024,        \"gradient_accumulation\": 8,        \"learning_rate\": 3e-4,        \"weight_decay\": 0.1,        \"checkpoint_every_optimizer_steps\": 10,        \"evaluation_every_optimizer_steps\": 100,        \"total_optimizer_steps\": 20000,        \"minimum_free_gpu_gib\": 8.0,    }    (runtime_dir / \"TRAINING_DEFAULTS.json\").write_text(        json.dumps(training_defaults, indent=2, sort_keys=True) + \"\\n",
    "\",        encoding=\"utf-8\",    )    (runtime_dir / \"README.md\").write_text(        \"# Bundled Q-Mini training runtime\\n",
    "\\n",
    "\"        \"This runtime is packaged with the initial model but disabled by default. \"        \"Activate it only through the separate QMini_Training_Runner.ipynb notebook. \"        \"The checkpoint manager writes verified immutable Drive generations and \"        \"updates one current-step progress record.\\n",
    "\",        encoding=\"utf-8\",    )    source_files = []    for source_file in sorted(        path for path in runtime_dir.rglob(\"*\")        if path.is_file() and path.name != \"TRAINING_RUNTIME.json\"    ):        source_files.append({            \"path\": source_file.relative_to(runtime_dir).as_posix(),            \"sha256\": sha256_file(source_file),            \"size_bytes\": source_file.stat().st_size,        })    runtime_manifest = {        \"format\": \"qmini-training-runtime-v1\",        \"enabled\": False,        \"requires_manual_activation\": True,        \"entrypoint\": \"qmini.train.train_model\",        \"checkpoint_backend\": \"qmini.checkpointing\",        \"checkpoint_policy\": {            \"progress_record\": \"training_state/training_progress.json\",            \"drive_snapshots_retained\": 2,            \"publish_after_each_saved_checkpoint\": True,            \"verify_sha256_and_torch_archive_crc\": True,            \"restore_previous_verified_generation_on_corruption\": True,            \"concurrent_session_lease\": True,        },        \"source_revision\": SOURCE_REVISION,        \"source_files\": source_files,    }    (runtime_dir / \"TRAINING_RUNTIME.json\").write_text(        json.dumps(runtime_manifest, indent=2, ensure_ascii=False, sort_keys=True) + \"\\n",
    "\",        encoding=\"utf-8\",    )    state_dir = LOCAL_PACKAGE_DIR / \"training_state\"    state_dir.mkdir(parents=True, exist_ok=False)    (state_dir / \"training_progress.json\").write_text(        json.dumps({            \"format\": \"qmini-training-progress-v1\",            \"status\": \"not_started\",            \"current_step\": 0,            \"target_steps\": None,            \"progress_percent\": 0.0,            \"tokens_seen\": 0,            \"updated_at\": datetime.now(timezone.utc).isoformat(),        }, indent=2, sort_keys=True) + \"\\n",
    "\",        encoding=\"utf-8\",    )    model_manifest[\"training_runtime_included\"] = True    model_manifest[\"training_runtime_enabled\"] = False    model_manifest[\"training_runtime_manifest_sha256\"] = sha256_file(        runtime_dir / \"TRAINING_RUNTIME.json\"    )    manifest_path.write_text(        json.dumps(model_manifest, indent=2, sort_keys=True, allow_nan=False) + \"\\n",
    "\",        encoding=\"utf-8\",    )    build_report[\"training_runtime\"] = {        \"included\": True,        \"enabled\": False,        \"source_file_count\": len(source_files),        \"manifest_sha256\": sha256_file(runtime_dir / \"TRAINING_RUNTIME.json\"),        \"separate_activation_notebook\": \"QMini_Training_Runner.ipynb\",        \"checkpoint_store\": \"training_state/\",    }    (LOCAL_PACKAGE_DIR / \"BUILD_REPORT.json\").write_text(        json.dumps(build_report, indent=2, ensure_ascii=False, sort_keys=True) + \"\\n",
    "\",        encoding=\"utf-8\",    )    # Validate the local package before copying it to Drive.    verified = verify_package(LOCAL_PACKAGE_DIR)    # Publish through a staging directory. Never overwrite an earlier package.    STAGING_DIR = FINAL_PACKAGE_DIR.parent / f\".{PACKAGE_NAME}.staging-{int(time.time())}\"    if STAGING_DIR.exists():        raise FileExistsError(f\"Staging directory already exists: {STAGING_DIR}\")    shutil.copytree(LOCAL_PACKAGE_DIR, STAGING_DIR)    verify_package(STAGING_DIR)    STAGING_DIR.rename(FINAL_PACKAGE_DIR)    PACKAGE_DIR = FINAL_PACKAGE_DIR# Re-verify the published Drive copy, not just the local source.verified = verify_package(PACKAGE_DIR)print(\"\\n",
